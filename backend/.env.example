# Development template; prefer: uv run --locked python scripts/init_dev.py
# backend/.env is loaded automatically; exported variables take precedence.
# Blank keys intentionally fail startup. Never use test_settings in deployment.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
BOT_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Standard proxy environment variables for official QQ HTTP API and Gateway.
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
# Legacy explicit override; leave empty to use standard environment variables.
QQ_HTTP_PROXY=
# Optional canonical official Gateway host; only known official hosts are allowed.
QQ_GATEWAY_HOST=

# OneBot upstream private/LAN or plaintext endpoints: explicit production opt-in.
# Defaults to 1 in DEBUG, 0 otherwise. Does not change public download/callback policy.
# ONEBOT_UPSTREAM_ALLOW_PRIVATE=0
# Production: DEBUG=0, DB_ENGINE=postgres, DB_NAME, DB_USER, DB_PASSWORD,
# DB_HOST, DB_PORT, DB_SSLMODE=require; HTTPS required. No trusted proxy default.
